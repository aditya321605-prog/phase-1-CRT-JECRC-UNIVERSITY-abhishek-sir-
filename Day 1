// GLOBAL VS LOCAL

#include<iostream>
using namespace std;

int globalVariable=100;
int main(){
    //local variable
    int userInput;
    float result;
    
    cin >> userInput;
    result=(double)globalVariable/userInput;
    
    cout<<result<<endl;
    
    return 0;
}
// logical and relational operators

#include<iostream>
using namespace std;

int main(){
    int side1, side2, side3;
    cin >> side1 >> side2 >> side3;
    
    bool isEqui = (side1 > 0)&&(side1 == side2)&&(side2 == side3);
    cout << isEqui << endl;
    return 0;
}   
// area of circle,rectangle ,triangle
#include <iostream>
using namespace std;

int main() {
    int choice;
    cin >> choice;

    if (choice == 1) {
        double radius;
        cin >> radius;
        cout << 3.14 * radius * radius << endl;
    } 
    else if (choice == 2) {
        double length, width;
        cin >> length >> width;
        cout << length * width << endl;
    } 
    else if (choice == 3) {
        double base, height;
        cin >> base >> height;
        cout << 0.5 * base * height << endl;
    } 
    else {
        cout << "invalid Choice" << endl;
    }

    return 0;
}
