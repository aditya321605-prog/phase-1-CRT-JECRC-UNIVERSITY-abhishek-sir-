//problem--5 linear search
#include<iostream>
using namespace std;
int linearsearch(int arr[],int size,int targetvalue){
    for(int i=0;i<size;i++){
        if(arr[i] == targetvalue){
            return i;
        }
    }
    return -1;
}
int main() {
    int arr[] = {10,20,30,40,50};
   int index = linearsearch(arr,5,40);
    cout << index;
}
