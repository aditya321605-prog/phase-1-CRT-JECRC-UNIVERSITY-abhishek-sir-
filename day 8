class animal{
    public :
    virtual void sound() {
        cout << "animal make sound";
    }
};
class dog : public animal{
    public :
    void sound() override {
        cout << "dog make a sound" << "\n";
    }
};
class cat : public animal{
    public :
    void sound() override {
        cout << "cat meow" << "\n";
    }
};
int main() {
    dog d1;
    cat c1;
    c1.sound();
    d1.sound();
}
