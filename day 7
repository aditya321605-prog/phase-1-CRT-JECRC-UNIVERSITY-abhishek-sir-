#include<iostream>
using namespace std;
class bankaccount{
    private:
    int balance;
    public:
    void setbalance(int amount){
        if(amount >=0){
            balance = amount;
    
  }  else {
        cout <<"enter a valid no";
    }
        
    }
    public:
    int getbalance(){
        return balance;
    }
    
};

int main() {
    bankaccount obj1;
    obj1.setbalance(6000);
   cout << obj1.getbalance();
}

