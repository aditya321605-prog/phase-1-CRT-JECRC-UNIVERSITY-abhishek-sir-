//problem--7
//access specifier
//7.2--public
#include<iostream>
using namespace std;
class parent{
    protected:
   
   int secretcode = 1234;
};
class child : public parent{
    public:
    void accessofsecretcode() {
        cout << "secretcode of the locker" << secretcode;
    }
};
   
   
int main(){
    child obj1;
    obj1.accessofsecretcode();
}
