//prime number checker 
#include <iostream>
using namespace std;
int main(){
    
    int n;
    cin >> n;
    bool isprime=true;
    
    if(n<2){
        isprime = false;
        
    }else {
        for (int i=2; i<n; i++){
            if(n % i==0){
                isprime=false;
                break;
                
            }
        }
    }
    if(isprime){               // dont change
        cout<<"prime number";
        
    }else {
        cout<<"not a prime number ";
        
    }
    return 0;
}
